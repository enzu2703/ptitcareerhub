rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user has admin role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Jobs Collection:
    // Students can only read active jobs
    // Admin has full CRUD permissions
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    // Events Collection:
    // Students can only read active events
    // Admin has full CRUD permissions
    match /events/{eventId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    // Users Collection:
    // Student can read and write their own profile
    // Admin can read all user data for reporting
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Interactions Collection (Telemetry & Engagement analytics):
    // Public/student create allowed for event tracking
    // Admin read allowed for analytics
    match /interactions/{interactionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}

